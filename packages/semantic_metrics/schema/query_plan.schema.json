{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bridge:schema:semantic:query-plan:v1",
  "$comment": "contract=query-plan-ir version=1 status=DRAFT owner_task=API-002 decisions=D-02,D-05,D-10,D-11,D-22 last_changed=2026-09-28 backlog=API.md §3 (QueryPlan IR row), API-002-S03/S06, G-API-05/06/14; ADR-005 amendment §6 (server-signed plan)",
  "title": "QueryPlanIR",
  "description": "Typed, fully resolved analytical plan emitted by the API planner and executed only by the query broker (D-22). SQL is generated by the broker from this IR alone. Canonical JSON = RFC 8785 (JCS) of the object without `sig`; `sig` = base64url(Ed25519(canonical_json)) with the API signing key (Secrets Manager `bridge/<env>/api/plan-signing-key`; the broker holds the public key). The broker rejects: bad signature, exp < now, exp − iat > 30 s, plan_version unknown, registry_version it cannot load. Every literal is a bound parameter in `params`; identifiers come only from the registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_version", "plan_id", "request_id", "tenant_id", "subject_id", "principal_kind", "profile_hash", "membership_epoch", "authz_epoch", "publication_id", "pub_seq", "serving_schema_version", "registry_version", "mode", "class", "period", "metrics", "dimensions", "filters", "params", "sort", "limit", "currency_rule", "maturity", "privacy_mode", "tier", "hot_days", "deadline_ms", "iat", "exp", "sig"],
  "properties": {
    "plan_version": {"const": 1},
    "plan_id": {"type": "string", "format": "uuid", "description": "UUIDv7; also used as replay guard (broker keeps seen plan_ids until exp)."},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$"},
    "job_id": {"type": ["string", "null"], "format": "uuid", "description": "Set for class JOB (analysis/export job); result rows are written to SERVING_JOBS.JOB_RESULT for (tenant_id, job_id, attempt)."},
    "job_attempt": {"type": ["integer", "null"], "minimum": 1},
    "tenant_id": {"type": "string", "format": "uuid"},
    "subject_id": {"type": "string", "format": "uuid"},
    "principal_kind": {"enum": ["USER", "MACHINE_CLIENT", "SYSTEM_EVALUATOR"]},
    "profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Content address of the caller's normalized permission profile (SEC-101); the broker maps it to role BRIDGE_<ENV>_T_<TENANT_SHORT>_P_<first 16 hex>."},
    "membership_epoch": {"type": "integer", "minimum": 0},
    "authz_epoch": {"type": "integer", "minimum": 0},
    "publication_id": {"type": "string", "pattern": "^pub_[0-9]{1,19}$", "description": "Tenant publication pinned at request start ('latest' already resolved)."},
    "pub_seq": {"type": "integer", "minimum": 1},
    "serving_schema_version": {"type": "integer", "minimum": 1},
    "registry_version": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mode": {"enum": ["AGGREGATE", "RECORDS"]},
    "class": {"enum": ["INTERACTIVE", "JOB"], "description": "INTERACTIVE: serving warehouse, deadline_ms ≤ 15,000; JOB: jobs warehouse, ≤ 1,800,000 ms (planner_limits.yaml)."},
    "period": {"$ref": "#/$defs/period"},
    "grain": {"enum": ["day", "week", "month", null], "description": "Time dimension id used as the leading output dimension, or null."},
    "records_dataset": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$"},
    "records_columns": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "maxItems": 60},
    "metrics": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "requested_as", "relation", "measure_type", "role"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "version": {"type": "integer", "minimum": 1},
          "requested_as": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(@[1-9][0-9]*)?$", "description": "Original request token; differs from id@version after substitution."},
          "relation": {"type": ["string", "null"], "pattern": "^v_[a-z0-9_]+$"},
          "measure_type": {"enum": ["SUM", "RATIO", "PERCENTILE", "LATEST", "TWA", "GAUGE", "COUNT", "COUNT_DISTINCT", "MAX", "DERIVED", "NONE"]},
          "gauge_mode": {"enum": ["LATEST", "TWA", null]},
          "role": {"enum": ["OUTPUT", "OPERAND", "COMPARE_BASE"]},
          "denominator_readable": {"type": ["boolean", "null"], "description": "Resolved by the planner from the profile (SEC A.4); false ⇒ value null DENOMINATOR_OUTSIDE_SCOPE without executing the denominator."},
          "param_refs": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^p[0-9]+$"}}
        }
      }
    },
    "dimensions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "relation", "column_ref"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "relation": {"type": "string", "pattern": "^v_[a-z0-9_]+$"},
          "column_ref": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
          "join_path": {"type": ["string", "null"], "pattern": "^jp_[a-z0-9_]+$"},
          "expression": {"enum": ["COLUMN", "DATE_TRUNC_WEEK", "DATE_TRUNC_MONTH", "DATE_OF_TIMESTAMP"]},
          "forced_by": {"enum": ["REQUEST", "CURRENCY_RULE", "GRAIN"], "description": "CURRENCY_RULE: currency added because the authorized scope holds several currencies and no currency filter was given (G-API-14)."}
        }
      }
    },
    "filters": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "op", "param_refs", "origin"],
        "properties": {
          "dimension": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "relation": {"type": "string", "pattern": "^v_[a-z0-9_]+$"},
          "column_ref": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
          "op": {"enum": ["EQ", "IN", "NOT_IN", "PREFIX", "IS_NULL", "IS_NOT_NULL", "BETWEEN"]},
          "param_refs": {"type": "array", "items": {"type": "string", "pattern": "^p[0-9]+$"}, "maxItems": 500},
          "origin": {"enum": ["REQUEST", "SCOPE_INTERSECTION", "METRIC_POPULATION", "MATURITY", "CURRENCY", "TENANT_PRUNING"], "description": "TENANT_PRUNING = `tenant_id = ?` added to every relation for clustering pruning; security still relies on the row access policy (API-101-S04)."}
        }
      }
    },
    "params": {
      "type": "object",
      "propertyNames": {"pattern": "^p[0-9]+$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value"],
        "properties": {
          "type": {"enum": ["STRING", "UUID", "DATE", "TIMESTAMP", "DECIMAL", "INTEGER", "BOOLEAN"]},
          "value": {"type": ["string", "boolean", "integer"], "description": "DECIMAL values are decimal strings; TIMESTAMP values RFC 3339 UTC with Z."}
        }
      }
    },
    "compare": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["mode", "base_period", "current_period_effective", "truncated_to_complete_day"],
      "properties": {
        "mode": {"enum": ["PREVIOUS_PERIOD", "SAME_PERIOD_LAST_YEAR", "CUSTOM"]},
        "base_period": {"$ref": "#/$defs/period"},
        "current_period_effective": {"$ref": "#/$defs/period"},
        "truncated_to_complete_day": {"type": "boolean"}
      }
    },
    "top_n": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["n", "by_metric", "other"],
      "properties": {
        "n": {"type": "integer", "minimum": 1, "maximum": 100},
        "by_metric": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "partition_by": {"type": "array", "items": {"type": "string"}, "maxItems": 2},
        "other": {"const": "REAGGREGATE_BASE_MEASURES"}
      }
    },
    "sort": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "direction", "nulls"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
          "direction": {"enum": ["ASC", "DESC"]},
          "nulls": {"const": "LAST"}
        }
      },
      "description": "Always ends with row_key ASC (stable tie-breaker, API-003-S06)."
    },
    "limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "keyset_after": {"type": ["array", "null"], "items": {"type": ["string", "integer", "boolean", "null"]}, "description": "Typed values of the sort tuple after which the page starts (decrypted from the sealed cursor)."},
    "currency_rule": {"enum": ["FILTERED", "FORCED_DIMENSION", "SINGLE_CURRENCY_SCOPE", "NOT_APPLICABLE"]},
    "maturity": {"enum": ["ALL", "FINAL_OR_BETTER", "RECONCILED_ONLY"]},
    "privacy_mode": {"enum": ["FULL", "SANITIZED", "METADATA_ONLY"]},
    "substitution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["requested", "served", "unattributed_row_key"],
      "properties": {
        "requested": {"type": "string", "pattern": "^[a-z][a-z0-9_]*@[1-9][0-9]*$"},
        "served": {"type": "string", "pattern": "^[a-z][a-z0-9_]*@[1-9][0-9]*$"},
        "unattributed_row_key": {"const": "__UNATTRIBUTED__"}
      }
    },
    "tier": {"enum": ["HOT", "AGGREGATE", "FULL"]},
    "hot_days": {"type": "integer", "minimum": 1, "maximum": 365},
    "allocation_publication_id": {"type": ["string", "null"], "description": "Pinned allocation publication (ALC-102-S04) when the request pins one; else FLOATING_LATEST resolved at request start."},
    "deadline_ms": {"type": "integer", "minimum": 100, "maximum": 1800000},
    "statement_queued_timeout_s": {"type": "integer", "minimum": 1, "maximum": 1800},
    "statement_timeout_s": {"type": "integer", "minimum": 1, "maximum": 1800},
    "totals": {"type": "boolean", "description": "Compute full-result totals (not page totals) with GROUPING SETS in the same statement."},
    "query_tag": {"type": "string", "maxLength": 2000, "description": "QUERY_TAG JSON v1 (OPS-109, data/contracts/query_tag.schema.json); carries request_id and plan shape hash, never names or values."},
    "plan_shape_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the plan with params and period values removed; key of the Redis EWMA (G-API-06)."},
    "iat": {"type": "string", "format": "date-time"},
    "exp": {"type": "string", "format": "date-time"},
    "sig": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$", "description": "base64url (no padding) Ed25519 signature, 64 bytes."}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "RECORDS"}}}, "then": {"required": ["records_dataset", "records_columns"], "properties": {"limit": {"maximum": 200}}}},
    {"if": {"properties": {"class": {"const": "JOB"}}}, "then": {"required": ["job_id", "job_attempt"]}},
    {"if": {"properties": {"class": {"const": "INTERACTIVE"}}}, "then": {"properties": {"deadline_ms": {"maximum": 15000}}}}
  ],
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "end": {"type": "string", "format": "date-time", "pattern": "Z$"}
      },
      "description": "Half-open [start, end) UTC (CONVENTIONS §4)."
    }
  }
}
