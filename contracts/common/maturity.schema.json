    "period_state": {"type": "string", "enum": ["OPEN", "MONTH_STABLE", "CLOSED", "RESTATED"]},
    "price_basis": {"type": "string", "enum": ["BILLED_SOURCE", "CONTRACT_RATE_ESTIMATE", "CUSTOMER_APPROVED_RATE", "UNKNOWN"]},
