{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bridge:schema:semantic:record-dataset:v1",
  "$comment": "contract=semantic-record-dataset-schema version=1 status=DRAFT owner_task=API-104 decisions=D-10,D-11,D-12 last_changed=2026-09-28 backlog=API.md G-API-10, API-104-S01/S02/S10",
  "title": "RecordDataset",
  "description": "Allowlisted record-level dataset served by POST /v1/analytics/records (IR mode RECORDS): declared columns, filters, sort keys, tier and per-column capability gating. Records never bypass the registry, pagination or non-enumeration rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "release", "relation", "tier", "row_key", "default_sort", "page_max", "sync_max_range_days", "privacy", "columns", "owner_task"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["ACTIVE", "DEPRECATED", "RETIRED"]},
    "release": {"enum": ["R1", "R2"]},
    "label_key": {"type": "string", "pattern": "^records\\.[a-z0-9_]+\\.label$"},
    "relation": {"type": "string", "pattern": "^v_[a-z0-9_]+$"},
    "population": {"type": "array", "items": {"$ref": "urn:bridge:schema:semantic:metric:v1#/$defs/predicate"}},
    "tier": {"enum": ["HOT", "FULL"], "description": "HOT datasets refuse ranges older than hot_days with 422 QUERY_RANGE_TOO_LARGE and guidance to family aggregates (API-104-S07)."},
    "row_key": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"}, "minItems": 1, "description": "Stable unique key per row (keyset tie-breaker, API-003-S06)."},
    "default_sort": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["column", "direction"], "properties": {"column": {"type": "string"}, "direction": {"enum": ["ASC", "DESC"]}}}},
    "page_max": {"type": "integer", "minimum": 1, "maximum": 200},
    "sync_max_range_days": {"type": "integer", "minimum": 1, "maximum": 366},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability"],
      "properties": {
        "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"},
        "org_scope_rows_require": {"type": "string", "description": "Rows with scope_kind=ORGANIZATION require an unrestricted-account grant on the organization (G-FIN-25)."}
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "column_ref", "type", "label_key", "sortable", "filter_ops"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "column_ref": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
          "type": {"enum": ["MONEY", "DECIMAL", "INTEGER", "STRING", "UUID", "TIMESTAMP", "DATE", "BOOLEAN", "ENUM", "DURATION_MS", "BYTES", "HASH", "SQL_TEXT"]},
          "currency_column": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$", "description": "Required for MONEY columns."},
          "label_key": {"type": "string", "pattern": "^records\\.[a-z0-9_]+\\.column\\.[a-z0-9_]+$"},
          "sortable": {"type": "boolean"},
          "filter_ops": {"type": "array", "items": {"$ref": "urn:bridge:schema:semantic:metric:v1#/$defs/filter_op"}, "uniqueItems": true},
          "dimension": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Registry dimension used for filter semantics and entitlement intersection."},
          "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$", "description": "Column hidden (and listed in meta.warnings COLUMN_HIDDEN) unless the caller holds it."},
          "privacy_mode_min": {"enum": ["METADATA_ONLY", "SANITIZED", "FULL"], "description": "Tenant privacy mode required; below it the value is null SUPPRESSED_PRIVACY."},
          "privacy": {"enum": ["PUBLIC", "INTERNAL", "CUSTOMER_METADATA", "PERSONAL", "SQL_TEXT"]},
          "default_visible": {"type": "boolean", "default": true}
        },
        "allOf": [{"if": {"properties": {"type": {"const": "MONEY"}}}, "then": {"required": ["currency_column"]}}]
      }
    },
    "owner_task": {"type": "string", "pattern": "^[A-Z]{2,3}-[0-9]{3}$"},
    "notes": {"type": "string"}
  }
}
