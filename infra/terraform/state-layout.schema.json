{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bridge:schema:infra:terraform-state-layout:v1",
  "$comment": "contract=terraform-state-layout-schema version=1 status=DRAFT owner_task=INF-001 decisions=D-25 last_changed=2026-09-28",
  "title": "Terraform state layout",
  "type": "object",
  "required": ["schema_version", "terraform", "backend", "cross_stack_outputs", "guards", "accounts", "stacks", "protected_resource_types"],
  "properties": {
    "schema_version": {"const": 1},
    "terraform": {"type": "object", "required": ["required_version", "providers"]},
    "backend": {
      "type": "object",
      "required": ["type", "bucket_pattern", "key_pattern", "lock", "region", "encrypt", "kms_key_alias_pattern"],
      "properties": {
        "type": {"const": "s3"},
        "bucket_pattern": {"const": "bridge-tfstate-{name}-{aws_account_id}-euw1"},
        "key_pattern": {"const": "{stack}/terraform.tfstate"},
        "lock": {"type": "object", "required": ["use_lockfile"], "properties": {"use_lockfile": {"const": true}, "dynamodb_table": {"type": "null"}}},
        "region": {"const": "eu-west-1"},
        "encrypt": {"const": true}
      }
    },
    "cross_stack_outputs": {"type": "object", "required": ["mechanism", "name_pattern"], "properties": {"mechanism": {"const": "ssm_parameter_store"}, "name_pattern": {"const": "/bridge/{env}/{stack}/{key}"}}},
    "guards": {"type": "object"},
    "accounts": {
      "type": "object",
      "propertyNames": {"enum": ["management", "security", "log-archive", "shared-services", "dev", "staging", "prod"]},
      "additionalProperties": {"type": "array", "items": {"type": "string", "pattern": "^(org|shared|test-estate|[0-9]{2}-[a-z0-9-]+)$"}, "uniqueItems": true}
    },
    "stacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner_task", "contents", "depends_on", "applied_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^(org|shared|test-estate|[0-9]{2}-[a-z0-9-]+)$"},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "contents": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "protected_resource_types": {"type": "array", "items": {"type": "string", "pattern": "^(aws|snowflake)_[a-z0-9_]+$"}, "minItems": 1}
  }
}
