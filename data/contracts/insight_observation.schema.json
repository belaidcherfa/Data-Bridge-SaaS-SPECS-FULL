      "window_end": "2026-09-28T00:00:00.000Z",
      "current_window": {"start": "2026-09-14T00:00:00.000Z", "end": "2026-09-28T00:00:00.000Z"},
      "baseline_window": null,
      "input_pub_seq": 48211,
      "input_publication_ids": {"fct_ins_wh_hourly": 48211, "fct_ins_wh_busy_intervals": 48190, "dim_warehouse_config": 48205},
      "config_version": 3,
      "parameter_set_sha256": "9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b",
      "feature_snapshot_hash": "0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c",
      "eligibility_status": "QUALIFIED",
      "reason_code": null,
      "metrics": [
        {"name": "auto_suspend_current_s", "value": "600", "unit": "SECOND"},
