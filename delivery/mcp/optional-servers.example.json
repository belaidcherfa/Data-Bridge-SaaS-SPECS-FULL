{
  "$comment": "status: DRAFT; owner_task: AGT-001. Optional MCP servers (docs/23-agentic-delivery/STACK.md §6). Copy the entries you need into the delivery server's user-level config (~/.claude.json via `claude mcp add-json`), NOT into the committed .mcp.json. Credentials come from environment variables of the service user; DEV/test resources only; never production or customer data.",
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {"Authorization": "Bearer ${GITHUB_MCP_TOKEN}"}
    },
    "snowflake-dev": {
      "command": "uvx",
      "args": ["snowflake-labs-mcp@1.4.2", "--service-config-file", "delivery/mcp/snowflake-dev.tools.yaml", "--connection-name", "bridge_dev_readonly"]
    },
    "postgres-local": {
      "command": "uvx",
      "args": ["postgres-mcp@0.3.0", "--access-mode=restricted"],
      "env": {"DATABASE_URI": "postgresql://bridge_readonly@localhost:5432/bridge"}
    },
    "aws-api-dev": {
      "command": "uvx",
      "args": ["awslabs.aws-api-mcp-server@1.5.5"],
      "env": {"AWS_REGION": "eu-west-1", "AWS_API_MCP_PROFILE_NAME": "bridge-dev-readonly", "READ_OPERATIONS_ONLY": "true", "FASTMCP_LOG_LEVEL": "ERROR"}
    },
    "cloudwatch-dev": {
      "command": "uvx",
      "args": ["awslabs.cloudwatch-mcp-server@0.3.1"],
      "env": {"AWS_REGION": "eu-west-1", "AWS_PROFILE": "bridge-dev-readonly", "FASTMCP_LOG_LEVEL": "ERROR"}
    }
  }
}
