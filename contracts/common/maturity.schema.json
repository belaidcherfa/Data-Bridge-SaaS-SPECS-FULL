{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bridge:schema:common:maturity:v1",
  "$comment": "contract=maturity version=1 status=ACCEPTED owner_task=FIN-104 decisions=D-13 last_changed=2026-09-28",
  "title": "Maturity and financial state enums",
  "$defs": {
    "data_status": {"type": "string", "enum": ["PROVISIONAL", "FINAL", "RECONCILED"]},
