{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAllInSuspendedOu",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalARN": [
            "arn:aws:iam::*:role/bridge-break-glass"
          ]
        }
      }
    }
  ]
}
