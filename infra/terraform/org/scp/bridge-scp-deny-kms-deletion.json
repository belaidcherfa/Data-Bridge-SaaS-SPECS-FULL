{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyKmsKeyDestruction",
      "Effect": "Deny",
      "Action": [
        "kms:ScheduleKeyDeletion",
        "kms:DeleteImportedKeyMaterial",
        "kms:DisableKey",
        "kms:PutKeyPolicy"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalARN": [
            "arn:aws:iam::*:role/bridge-break-glass",
            "arn:aws:iam::*:role/bridge-*-tf-apply"
          ]
        }
      }
    },
    {
      "Sid": "DenyKmsDeletionEvenForApply",
      "Effect": "Deny",
      "Action": [
        "kms:ScheduleKeyDeletion",
        "kms:DeleteImportedKeyMaterial",
        "kms:DisableKey"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalARN": [
            "arn:aws:iam::*:role/bridge-break-glass"
          ]
        }
      }
    }
  ]
}
