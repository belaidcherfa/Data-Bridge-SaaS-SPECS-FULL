      "revision_id": 7
    }
  ],
  "x-negative-examples": [
    {"why": "float money", "patch": {"impact_amount_30d": 108.0}},
    {"why": "missing metric unit", "patch": {"metrics": [{"name": "saving_credits", "value": "25.2"}]}},
    {"why": "unknown reason code", "patch": {"eligibility_status": "SUPPRESSED", "reason_code": "NOT_A_CODE"}},
    {"why": "potential without potential_method", "patch": {"potential_method": null}},
    {"why": "CEILING with a numeric potential", "patch": {"impact_kind": "CEILING"}},
    {"why": "foreign tenant row inside a run for tenant 01923f6a-7c1e-7a10-9b2d-3c4d5e6f7a80 (schema-valid; rejected at runtime by the ORC-103 tenant guard: whole run REJECTED, 0 rows landed)", "runtime": true, "patch": {"tenant_id": "01923f6a-7c1e-7a10-9b2d-3c4d5e6f7b99"}}
  ]
}
